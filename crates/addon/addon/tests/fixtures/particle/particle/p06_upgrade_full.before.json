        "activation_expression": 1,
        "expiration_expression": "variable.emitter_age > 4"
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": "demo:burst",
        "expiration_event": ["demo:burst"],
        "timeline": { "0.5": "demo:burst" },
        "travel_distance_events": { "2.0": ["demo:burst"] },
        "looping_travel_distance_events": [{ "distance": 1, "effects": "demo:burst" }]
      },
      "minecraft:emitter_rate_instant": { "num_particles": 10 },
      "minecraft:emitter_rate_steady": { "spawn_rate": "variable.rate", "max_particles": 50 },
      "minecraft:emitter_rate_manual": { "max_particles": 20 },
      "minecraft:emitter_shape_point": { "offset": [0, 1, 0] },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [1, "variable.height", 1],
        "surface_only": true,
        "direction": "inwards"
      },
      "minecraft:emitter_shape_sphere": { "radius": 2, "direction": "outwards" },
      "minecraft:emitter_shape_custom": { "offset": [0, 0, 0], "direction": [0, "variable.up", 0] },
      "minecraft:emitter_shape_entity_aabb": { "direction": [0, 1, 0] },
      "minecraft:emitter_shape_disc": { "radius": 1, "plane_normal": "x" },
      "minecraft:particle_appearance_billboard": {
        "size": ["variable.size", "variable.size"],
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": { "base_UV": [0, 0], "size_UV": [8, 8], "step_UV": [8, 0], "max_frame": 8 }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": { "0.0": "#FFFF0000", "1.0": [0, 0, 1, "variable.fade"] },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_initial_spin": { "rotation": "math.random(0, 360)", "rotation_rate": 10 },
      "minecraft:particle_initial_speed": 2,
      "minecraft:particle_initialization": { "per_render_expression": "variable.swell = 1;" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 1 },
      "minecraft:particle_expire_if_in_blocks": ["minecraft:water"],
      "minecraft:particle_expire_if_not_in_blocks": ["minecraft:air"],
