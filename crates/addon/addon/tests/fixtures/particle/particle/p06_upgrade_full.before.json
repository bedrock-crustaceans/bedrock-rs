// fixtures.md p06: a 1.10.0 document with one of each of the 29 components, two curves and one
// event. Loaded in a pack whose min_engine_version is 1.21.100 (Molang version 13).
{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "demo:full",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "curves": {
      "variable.fade": {
        "type": "linear",
        "input": "variable.particle_age",
        "horizontal_range": "variable.particle_lifetime",
        "nodes": [1, "variable.particle_random_1", 0]
      },
      "variable.swell": {
        "type": "bezier_chain",
        "input": "variable.particle_age",
        "nodes": {
          "0.0": { "value": 0, "slope": 1 },
          "1.0": { "left_value": 1, "right_value": 0.5, "left_slope": 0, "right_slope": -1 }
        }
      }
    },
    "events": {
      "demo:burst": {
        "particle_effect": { "effect": "demo:spark", "type": "emitter" },
        "sound_effect": { "event_name": "explode" },
        "log": "burst"
      }
    },
    "components": {
      "minecraft:emitter_local_space": { "position": true, "rotation": true },
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.size = 0.1;",
