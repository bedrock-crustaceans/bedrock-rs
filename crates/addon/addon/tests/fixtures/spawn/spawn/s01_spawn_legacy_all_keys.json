{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "x:mob",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:weight": {
          "default": 8,
          "rarity": 3
        },
        "minecraft:density_limit": {
          "surface": 4,
          "underground": 2
        },
        "minecraft:spawns_on_block_filter": "minecraft:grass_block",
        "minecraft:spawns_on_block_prevented_filter": [
          "minecraft:sand",
          {
            "name": "minecraft:stone",
            "states": {
              "stone_type": "granite"
            }
          }
        ],
        "minecraft:spawns_above_block_filter": {
          "blocks": "minecraft:water",
          "distance": 3
        },
        "minecraft:herd": {
          "min_size": 2,
          "max_size": 4,
          "event": "minecraft:entity_born",
          "event_skip_count": 1,
          "initial_event": "minecraft:start",
          "initial_event_count": 2
        },
        "minecraft:permute_type": [
          {
            "weight": 95,
            "entity_type": "x:mob"
          },
          {
            "weight": 5,
            "guaranteed_count": 1,
            "entity_type": "x:mob_baby"
          }
        ],
        "minecraft:brightness_filter": {
          "min": 7,
          "max": 15,
          "adjust_for_weather": true
        },
        "minecraft:height_filter": {
          "min": 0,
          "max": 64
        },
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_underground": {},
        "minecraft:spawns_underwater": {},
        "minecraft:spawns_lava": {},
        "minecraft:disallow_spawns_in_bubble": {},
        "minecraft:biome_filter": {
          "test": "has_biome_tag",
          "value": "plains"
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "normal"
        },
        "minecraft:distance_filter": {
          "min": 12,
          "max": 100
        },
        "minecraft:is_experimental": {},
        "minecraft:world_age_filter": {
          "min": 100,
          "max": 2000
        },
        "minecraft:delay_filter": {
          "min": 600,
          "max": 660,
          "identifier": "x:mob",
          "spawn_chance": 25
        },
        "minecraft:mob_event_filter": {
          "event": "minecraft:pillager_patrols_event"
        },
        "minecraft:is_persistent": {},
        "minecraft:player_in_village_filter": {
          "distance": 48,
          "village_border_tolerance": 32
        },
        "minecraft:spawn_event": {
          "event": "minecraft:entity_spawned"
        }
      },
      {
        "minecraft:herd": [
          {
            "min_size": 1,
            "max_size": 2
          },
          {
            "min_size": 3,
            "max_size": 3,
            "event": "minecraft:make_white"
          }
        ],
        "minecraft:permute_type": {
          "weight": 1,
          "entity_type": "x:other"
        }
      }
    ]
  }
}
