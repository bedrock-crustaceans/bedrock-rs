{
  "without_on_interact": {
    "interactions": { "cooldown": 2.5, "use_item": true, "on_interact": { "event": "x:sheared", "target": "self" } }
  },
  "with_on_interact": {
    "interactions": {
      "on_interact": { "event": "x:new", "filters": { "test": "is_family", "subject": "other", "value": "player" } }
