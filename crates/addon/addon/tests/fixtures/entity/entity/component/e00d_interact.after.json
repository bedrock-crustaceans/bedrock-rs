  "array": {
    "interactions": [
      { "on_interact": { "event": "x:a", "filters": { "test": "has_equipment", "domain": "hand", "subject": "other", "value": "shears" } } },
      { "interact_text": "action.interact.feed" }
    ]
  }
}
