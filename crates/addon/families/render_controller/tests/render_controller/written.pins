            "texture.brown"
          ]
        }
      },
      "geometry": "geometry.default",
      "part_visibility": [
        {
          "saddle": "query.is_saddled"
        }
      ],
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "textures": [
        "array.skins[query.variant]"
      ],
      "color": {
        "r": 1,
        "g": "query.is_baby ? 0.8 : 1.0"
      }
    },
    "controller.render.determinism_dropped": {
      "geometry": "geometry.default"
    }
  }
}

