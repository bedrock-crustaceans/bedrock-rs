// Dependency updates. Renovate finds every Cargo.toml of the workspace, the workflows and
// flake.lock on its own, so nothing here lists a directory.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Conventional Commits, as CONTRIBUTING.md asks: `chore(deps): update syn to v3`.
    ":semanticCommits",
    // Pin actions to a commit digest, keeping the version as a comment.
    "helpers:pinGitHubActionDigestsToSemver",
  ],
  labels: ["C-Dependencies"],
  timezone: "Europe/Berlin",
  schedule: ["before 6am on monday"],
  // Let a release sit before proposing it; a yanked or broken one rarely lasts three days.
  minimumReleaseAge: "3 days",
  nix: {
    enabled: true,
  },
  // `Cargo.lock` is not committed, so this refreshes `flake.lock` alone.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on the first day of the month"],
  },
  packageRules: [
    {
      description: "The workflows' actions, in one pull request.",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      semanticCommitType: "ci",
      semanticCommitScope: null,
    },
    {
      description: "The facet crates release together and must move together.",
      matchManagers: ["cargo"],
      matchPackageNames: ["facet", "facet-*"],
      groupName: "facet",
    },
    {
      description: "The RustCrypto crates of the auth and encryption code move together.",
      matchManagers: ["cargo"],
      matchPackageNames: ["p384", "sha2", "aes", "cfb8", "ctr"],
      groupName: "RustCrypto",
    },
    {
      description: "The proc-macro stack of the derives moves together.",
      matchManagers: ["cargo"],
      matchPackageNames: ["syn", "quote", "proc-macro2", "prettyplease"],
      groupName: "proc-macro",
    },
    {
      description: "strum and its macros share a version.",
      matchManagers: ["cargo"],
      matchPackageNames: ["strum", "strum_macros"],
      groupName: "strum",
    },
  ],
}
